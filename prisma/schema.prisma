generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  OUT_OF_SERVICE
}

model Table {
  id        String      @id @default(uuid())
  number    Int         @unique
  capacity  Int
  zone      String
  status    TableStatus @default(AVAILABLE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("tables")
}